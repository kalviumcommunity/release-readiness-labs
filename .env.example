# OrderFlow Application Environment Configuration Template
# Copy this file to .env and provide appropriate secret values
PORT=3000
NODE_ENV=production

# Sensitive credentials (injected via secrets manager / CI/CD secrets in production)
API_KEY=your_api_key_here
DATABASE_PASSWORD=your_db_password_here
TOKEN=your_token_here
AWS_SECRET_KEY=your_aws_secret_key_here

